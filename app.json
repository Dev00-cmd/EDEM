{
  "expo": {
    "name": "Ti Pwof",
    "slug": "yourydev",
    "owner": "yourydevs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tipwof",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D1B2A",
    "primaryColor": "#2563EB",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tipwof.app"
    },
    "android": {
      "package": "com.tipwof.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ti Pwof utilise tes photos pour que tu puisses envoyer une image de ton devoir au tuteur.",
          "cameraPermission": "Ti Pwof utilise l'appareil photo pour que tu puisses photographier ton devoir et le faire expliquer."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0D1B2A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "1d6cdcc0-c5b1-4c8f-b578-a3933f486f6b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1d6cdcc0-c5b1-4c8f-b578-a3933f486f6b"
    },
    "runtimeVersion": "1.0.0"
  }
}
