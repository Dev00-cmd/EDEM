# Les peers optionnels ne sont PAS installes automatiquement.
# Indispensable ici : react-native-worklets 0.12 (tire comme peer par
# @expo/ui et reanimated) casse la compilation C++ de expo-modules-core,
# qui attend la 0.10. Ni worklets ni reanimated ne sont utilises par
# l app : les exclure supprime le conflit a la racine.
legacy-peer-deps=true
